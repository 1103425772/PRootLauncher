<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="@color/primary_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/btn_browser"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="28dp"
            android:text="@string/btn_browser"
            android:textSize="10sp"
            android:background="@drawable/bg_btn_accent"
            android:textColor="@android:color/white"
            android:paddingHorizontal="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_x11"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="28dp"
            android:text="@string/btn_x11"
            android:textSize="10sp"
            android:background="@drawable/bg_btn_accent"
            android:textColor="@android:color/white"
            android:paddingHorizontal="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Terminal"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="28dp"
            android:text="@string/btn_exit_terminal"
            android:textSize="10sp"
            android:background="@drawable/bg_btn_accent"
            android:textColor="@android:color/white"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/terminal_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/terminal_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="4dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入命令..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/bg_input"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="28dp"
            android:text="发送"
            android:textSize="10sp"
            android:background="@drawable/bg_btn_primary"
            android:textColor="@android:color/white"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
